# node-server settings for this device. Copy to .env (or run `make env OWNER=<name>`).
# Every key is optional except AGENTFLEET_OWNER; the values shown are the defaults.
# Relative paths resolve from node-server/, where `make serve` / `make dev` run.

# Who owns this device; agent IDs created here must start with "<owner>/".
AGENTFLEET_OWNER=me

# Where the node server (A2A + API + dashboard) listens. Also used as its public base URL.
AGENTFLEET_HOST=127.0.0.1
AGENTFLEET_PORT=9100
AGENTFLEET_DATA_DIR=./data

# Local agentmesh-node API. Must match NODE_BIND given to scripts/start-mesh-node.sh.
AGENTFLEET_MESH_NODE_URL=http://127.0.0.1:8080
# Token for the mesh node API. Leave unset to read it from AGENTFLEET_MESH_API_TOKEN_PATH,
# which start-mesh-node.sh generates on first run.
# AGENTFLEET_MESH_API_TOKEN=
# Both default into the data dir: <data_dir>/mesh-api-token and <data_dir>/agentmesh-node.yaml.
# AGENTFLEET_MESH_API_TOKEN_PATH=./data/mesh-api-token
# AGENTFLEET_MESH_NODE_CONFIG_PATH=./data/agentmesh-node.yaml

# Dev/test only: skip mesh discovery and call peers directly. JSON object of owner -> base URL.
# AGENTFLEET_STATIC_PEERS={"alice": "http://127.0.0.1:9200"}

# Loop protection and timeouts (seconds).
AGENTFLEET_MAX_TURNS_PER_CONTEXT=20
AGENTFLEET_MAX_AGENT_TURNS_PER_MESSAGE=30
AGENTFLEET_TURN_TIMEOUT_S=600
AGENTFLEET_APPROVAL_TIMEOUT_S=300
AGENTFLEET_MANUAL_REPLY_TIMEOUT_S=900
AGENTFLEET_OUTBOUND_TIMEOUT_S=900

# File sharing: max inline file size (bytes) and allowed suffixes (JSON list).
AGENTFLEET_MAX_INLINE_FILE_BYTES=5242880
# AGENTFLEET_ALLOWED_FILE_SUFFIXES=[".txt", ".md", ".json", ".yaml", ".yml", ".csv", ".log", ".py", ".ts", ".tsx", ".js", ".sql", ".png", ".jpg", ".pdf"]

# Claude CLI path override (default: whatever the Agent SDK finds).
# AGENTFLEET_CLAUDE_CLI_PATH=/usr/local/bin/claude